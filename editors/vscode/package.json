{
  "name": "vyrn",
  "displayName": "Vyrn",
  "description": "Vyrn language support: completion, hover, go to definition, errors as you type, formatting, running and debugging",
  "version": "0.4.0",
  "publisher": "vyrn",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1d2b6e",
    "theme": "dark"
  },
  "homepage": "https://github.com/dmccottrell/vyrn",
  "bugs": {
    "url": "https://github.com/dmccottrell/vyrn/issues"
  },
  "keywords": [
    "vyrn",
    "language",
    "debugger",
    "games",
    "beginner"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vyrn",
    "onDebugResolve:vyrn",
    "onDebugDynamicConfigurations:vyrn"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vyrn",
        "aliases": [
          "Vyrn",
          "vyrn"
        ],
        "extensions": [
          ".vyrn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vyrn",
        "scopeName": "source.vyrn",
        "path": "./syntaxes/vyrn.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "vyrn.run",
        "title": "Vyrn: Run File"
      },
      {
        "command": "vyrn.test",
        "title": "Vyrn: Run Tests"
      },
      {
        "command": "vyrn.repl",
        "title": "Vyrn: Open Interactive Prompt"
      },
      {
        "command": "vyrn.debug",
        "title": "Vyrn: Debug File"
      }
    ],
    "configuration": {
      "title": "Vyrn",
      "properties": {
        "vyrn.path": {
          "type": "string",
          "default": "vyrn",
          "description": "The vyrn executable."
        },
        "vyrn.checkOnType": {
          "type": "boolean",
          "default": true,
          "description": "Check the file as you type (after a short pause), not only on save."
        },
        "vyrn.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Use the Vyrn language server (`vyrn lsp`) for completion, hover, definitions and errors."
        }
      }
    },
    "breakpoints": [
      {
        "language": "vyrn"
      }
    ],
    "debuggers": [
      {
        "type": "vyrn",
        "label": "Vyrn",
        "languages": [
          "vyrn"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .vyrn file to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the program.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "vyrn",
            "request": "launch",
            "name": "Debug this file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Vyrn: Debug a file",
            "description": "Run a .vyrn file in the debugger",
            "body": {
              "type": "vyrn",
              "request": "launch",
              "name": "Debug ${1:file}",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dmccottrell/vyrn"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
