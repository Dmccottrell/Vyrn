# door.vyrn: a door that slides open when the player comes near, and
# tells Blueprints when it opens and closes (so they can play a sound).
#
# On the door's VyrnScript component: Script = "door.vyrn". Optional
# Variables: "reach" (cm, default 300), "lift" (cm, default 250).

use unreal (Vec3, location, set_location, player, distance_to, get_var, event)

object Door:
    closed_at: Vec3 = Vec3()
    open_amount: float = 0.0    # 0 closed .. 1 fully open
    was_open: bool = false
end

const DOOR = Door()

create begin_play():
    DOOR.closed_at = location()
end

create tick(dt: float):
    let who = player()
    let near = who != none and distance_to(who) < float(get_var("reach", 300))
    # Ease towards open or closed: twice as fast to open as to close.
    let speed = 2.0 if near else 1.0
    let goal = 1.0 if near else 0.0
    DOOR.open_amount = DOOR.open_amount + (goal - DOOR.open_amount).clamp(-speed * dt, speed * dt)
    set_location(DOOR.closed_at + Vec3(0.0, 0.0, float(get_var("lift", 250)) * DOOR.open_amount))
    # Tell Blueprints when the door starts opening or finishes closing.
    if near and not DOOR.was_open: event("door_opened")
    if not near and DOOR.was_open and DOOR.open_amount == 0: event("door_closed")
    if near: DOOR.was_open = true
    if not near and DOOR.open_amount == 0: DOOR.was_open = false
end
