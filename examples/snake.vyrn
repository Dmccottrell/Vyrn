# Snake: arrow keys to steer, eat the food, don't hit yourself.
# Run it with `vyrn run examples/snake.vyrn`.
use std.draw
use std.random

const CELL = 20
const COLS = 30
const ROWS = 20

struct Cell:
    x: int
    y: int
end

create random_cell() -> Cell:
    return Cell(random.int(0, COLS - 1), random.int(0, ROWS - 1))
end

main:
    let win = draw.window(COLS * CELL, ROWS * CELL, "Snake")
    win.set_fps(10)
    var snake = [Cell(5, 10), Cell(4, 10), Cell(3, 10)]
    var dx = 1
    var dy = 0
    var food = random_cell()
    var score = 0
    var alive = true

    loop win.open():
        # Steer, but never straight back into yourself.
        if win.key_down("left") and dx == 0:
            dx = -1
            dy = 0
        else if win.key_down("right") and dx == 0:
            dx = 1
            dy = 0
        else if win.key_down("up") and dy == 0:
            dx = 0
            dy = -1
        else if win.key_down("down") and dy == 0:
            dx = 0
            dy = 1
        end

        if alive:
            let head = Cell((snake[0].x + dx) % COLS, (snake[0].y + dy) % ROWS)
            if snake.any(c => c.x == head.x and c.y == head.y):
                alive = false
            else:
                snake.insert(0, head)
                if head.x == food.x and head.y == food.y:
                    score += 1
                    food = random_cell()
                else:
                    snake.pop()
                end
            end
        else if win.key_pressed("space"):
            snake = [Cell(5, 10), Cell(4, 10), Cell(3, 10)]
            dx = 1
            dy = 0
            score = 0
            alive = true
        end

        win.clear("#102018")
        win.rect(food.x * CELL, food.y * CELL, CELL, CELL, "red")
        each c in snake:
            win.rect(c.x * CELL + 1, c.y * CELL + 1, CELL - 2, CELL - 2, "lime")
        end
        win.text("Score: {score}", 8, 8, "white")
        if not alive:
            win.text("Game over - press space", 140, 190, "yellow")
        end
        win.show()
    end
end
