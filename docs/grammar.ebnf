(* ============================================================================
   Vyrn Language Grammar -- v0.1 draft
   File extension: .vyrn

   Notation
     =      definition            ;      end of rule
     |      alternative           ( )    grouping
     [ ]    optional (0 or 1)     { }    repetition (0 or more)
     "x"    terminal              UPPER  token produced by the lexer (section 9)

   Layout
     Blocks are delimited by indentation. The lexer emits NEWLINE at the end of
     each logical line and INDENT / DEDENT when indentation changes. Blank lines
     and comments produce no tokens. Inside ( ), [ ] and { } newlines and
     indentation are ignored, so any bracketed construct may span lines.
   ============================================================================ *)


(* ---- 1. Module ----------------------------------------------------------- *)

module        = { NEWLINE | statement } ;

statement     = simple_stmt NEWLINE
              | compound_stmt ;

block         = simple_stmt NEWLINE
              | NEWLINE INDENT statement { statement } DEDENT ;


(* ---- 2. Simple statements ------------------------------------------------ *)

simple_stmt   = import_stmt
              | binding_stmt
              | type_alias
              | expr_stmt
              | return_stmt
              | raise_stmt
              | defer_stmt
              | "break"
              | "continue"
              | "pass" ;

import_stmt   = "import" import_name { "," import_name }
              | "from" dotted_name "import" ( "*" | import_name { "," import_name } ) ;
import_name   = dotted_name [ "as" IDENT ] ;
dotted_name   = IDENT { "." IDENT } ;

(* let = immutable, var = mutable, const = compile-time constant.
   In dynamic (non-strict) code a bare `x = 1` also introduces a mutable name. *)
binding_stmt  = [ "pub" ] ( "let" | "var" | "const" ) bind_target
                [ ":" type ] [ "=" expression_list ] ;
bind_target   = bind_name { "," bind_name } ;
bind_name     = IDENT | "_" | "(" bind_target ")" ;

type_alias    = [ "pub" ] "type" IDENT [ generic_params ] "=" type ;

(* Covers bare expressions, assignment, annotated assignment and augmented
   assignment. The left side of an assignment must be an assignable place
   (name, field, subscript or tuple of those); this is checked after parsing. *)
expr_stmt     = expression_list
                [ ":" type [ "=" expression_list ]
                | "=" expression_list
                | assign_op expression_list ] ;
assign_op     = "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "@=" | "**="
              | "&=" | "|=" | "^=" | "<<=" | ">>=" | "??=" ;

return_stmt   = "return" [ expression_list ] ;
raise_stmt    = "raise" expression ;
defer_stmt    = "defer" expression ;


(* ---- 3. Compound statements ---------------------------------------------- *)

compound_stmt = declaration
              | if_stmt
              | while_stmt
              | for_stmt
              | match_stmt
              | try_stmt
              | with_stmt
              | on_stmt
              | unsafe_stmt ;

if_stmt       = "if" condition ":" block
                { "elif" condition ":" block }
                [ "else" ":" block ] ;
while_stmt    = "while" condition ":" block ;
condition     = expression
              | "let" pattern "=" expression ;

(* `for mut e in xs` borrows each element mutably, `for own e in xs` consumes
   the collection. `par for` runs iterations in parallel (threads or devices);
   `async for` awaits an async stream. *)
for_stmt      = [ "async" | "par" ] "for" [ pass_mode ] bind_target
                "in" expression ":" block ;

match_stmt    = "match" expression ":" NEWLINE INDENT case_clause { case_clause } DEDENT ;
case_clause   = "case" pattern [ "if" expression ] ":" block ;

try_stmt      = "try" ":" block
                { "catch" [ type [ "as" IDENT ] ] ":" block }
                [ "finally" ":" block ] ;

with_stmt     = [ "async" ] "with" with_item { "," with_item } ":" block ;
with_item     = expression [ "as" IDENT ] ;

(* Device scope: every tensor allocated and every kernel dispatched inside the
   block targets the given device, e.g. `on gpu[0]:`, `on gpu[0..4]:`, `on cpu:`. *)
on_stmt       = "on" or_expr ":" block ;

unsafe_stmt   = "unsafe" ":" block ;


(* ---- 4. Declarations ----------------------------------------------------- *)

declaration   = { decorator } [ "pub" ]
                ( fn_decl
                | struct_decl
                | class_decl
                | enum_decl
                | trait_decl
                | impl_decl
                | route_decl
                | route_group
                | extern_decl ) ;

decorator     = "@" dotted_name [ "(" [ arguments ] ")" ] NEWLINE ;

(* Functions.
     async   returns a future; may use await
     strict  every binding must be statically typed; no dynamic dispatch
     kernel  strict + lowered through MLIR for CPU SIMD / GPU execution
     export  exposed to the host ABI, e.g. export "wasm" fn render()          *)
fn_decl       = fn_head ":" block ;
fn_sig        = fn_head NEWLINE ;
fn_head       = { fn_modifier } "fn" IDENT [ generic_params ]
                "(" [ params ] ")" [ "->" return_type ] ;
fn_modifier   = "async" | "strict" | "kernel" | "export" [ STRING ] ;
return_type   = type [ "!" type ] ;

(* Parameter passing. No lifetime annotations exist in the language.
     x: T        shared read-only borrow (the default)
     mut x: T    exclusive mutable borrow
     own x: T    ownership is moved into the callee
   An omitted type means `any` (dynamically typed).                            *)
params        = param { "," param } [ "," ] ;
param         = [ pass_mode ] IDENT [ ":" type ] [ "=" expression ]
              | "*" IDENT [ ":" type ]
              | "**" IDENT [ ":" type ] ;
pass_mode     = "mut" | "own" ;

generic_params = "[" generic_param { "," generic_param } "]" ;
generic_param  = IDENT [ ":" type { "+" type } ] ;

(* struct: value type, statically sized, stored inline, no header.
   class:  reference type, heap allocated, automatically reference counted.   *)
struct_decl   = "struct" IDENT [ generic_params ] ":" type_body ;
class_decl    = "class" IDENT [ generic_params ] ":" type_body ;
type_body     = NEWLINE INDENT member { member } DEDENT ;
member        = field_decl
              | method_decl
              | "pass" NEWLINE ;
field_decl    = [ "pub" ] IDENT ":" type [ "=" expression ] NEWLINE ;
method_decl   = { decorator } [ "pub" ] fn_decl ;

enum_decl     = "enum" IDENT [ generic_params ] ":"
                NEWLINE INDENT enum_member { enum_member } DEDENT ;
enum_member   = variant | method_decl ;
variant       = IDENT [ "(" variant_field { "," variant_field } ")"
                      | "=" expression ] NEWLINE ;
variant_field = [ IDENT ":" ] type ;

trait_decl    = "trait" IDENT [ generic_params ] [ "(" type { "," type } ")" ] ":"
                NEWLINE INDENT trait_member { trait_member } DEDENT ;
trait_member  = fn_sig | method_decl | "pass" NEWLINE ;

impl_decl     = "impl" [ generic_params ] [ type "for" ] type ":"
                NEWLINE INDENT method_decl { method_decl } DEDENT ;

(* HTTP routing. A route is an implicitly async function bound to a method and
   a path template. Parameters named in the path are parsed from the URL;
   struct-typed parameters are decoded from the request body; anything else is
   resolved from registered providers. The return value is serialized (JSON by
   default) according to its type.                                             *)
route_decl    = "route" http_method STRING [ "(" [ params ] ")" ]
                [ "->" return_type ] ":" block ;
route_group   = "routes" STRING ":" NEWLINE INDENT route_item { route_item } DEDENT ;
route_item    = { decorator } ( route_decl | route_group ) ;
http_method   = "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
              | "HEAD" | "OPTIONS" | "WS" | "SSE" ;

(* Foreign functions: extern "c", extern "js" (WebAssembly host imports). *)
extern_decl   = "extern" STRING
                ( fn_sig
                | ":" NEWLINE INDENT fn_sig { fn_sig } DEDENT ) ;


(* ---- 5. Types ------------------------------------------------------------ *)

(* A trailing `on <device>` pins the storage of a value to a device:
   `w: tensor[f16; V, D] on gpu[0]`.                                           *)
type          = union_type [ "on" or_expr ] ;
union_type    = optional_type { "|" optional_type } ;
optional_type = primary_type { "?" } ;

primary_type  = "any"
              | named_type
              | tensor_type
              | "[" type [ ";" expression ] "]"
              | "{" type [ ":" type ] "}"
              | "(" [ type { "," type } ] ")"
              | "fn" "(" [ type { "," type } ] ")" [ "->" type ]
              | ownership primary_type ;

(* [T]      growable list          [T; N]   fixed array, stored inline
   {K: V}   map                    {T}      set
   (A, B)   tuple                  T?       optional                           *)

named_type    = dotted_name [ "[" generic_arg { "," generic_arg } "]" ] ;
generic_arg   = type | INT ;

(* tensor[dtype; d0, d1, ...]. A dimension is a constant expression, a shape
   variable (any free identifier, implicitly generic over the function), `_`
   for "unchecked", or `...` for "any number of leading dimensions".
   Shapes are checked at compile time in strict code and at run time otherwise. *)
tensor_type   = "tensor" "[" type [ ";" dim { "," dim } ] "]" ;
dim           = "_" | "..." | sum ;

(* ref T      borrowed view, lifetime inferred (never written by the user)
   ref mut T  exclusive borrowed view
   shared T   reference-counted shared ownership
   weak T     non-owning reference to a shared value
   ptr T      raw pointer, usable only inside `unsafe`                         *)
ownership     = "ref" [ "mut" ] | "shared" | "weak" | "ptr" ;


(* ---- 6. Expressions (lowest to highest precedence) ----------------------- *)

expression_list = expression { "," expression } [ "," ] ;

expression    = lambda
              | conditional ;
lambda        = [ "async" ] "fn" "(" [ params ] ")" "=>" expression ;
conditional   = pipeline [ "if" pipeline "else" expression ] ;
pipeline      = placement { "|>" placement } ;

(* `x on gpu[1]` yields x placed on (moved or copied to) the given device. *)
placement     = coalesce [ "on" coalesce ] ;
coalesce      = or_expr { "??" or_expr } ;
or_expr       = and_expr { "or" and_expr } ;
and_expr      = not_expr { "and" not_expr } ;
not_expr      = "not" not_expr
              | comparison ;
comparison    = range_expr { comp_op range_expr } ;
comp_op       = "==" | "!=" | "<" | "<=" | ">" | ">="
              | "in" | "not" "in" | "is" | "is" "not" ;
range_expr    = bit_or [ ( ".." | "..=" ) bit_or ] ;
bit_or        = bit_xor { "|" bit_xor } ;
bit_xor       = bit_and { "^" bit_and } ;
bit_and       = shift { "&" shift } ;
shift         = sum { ( "<<" | ">>" ) sum } ;
sum           = term { ( "+" | "-" ) term } ;

(* `@` is matrix multiplication; it broadcasts over leading batch dimensions. *)
term          = unary { ( "*" | "/" | "//" | "%" | "@" ) unary } ;
unary         = ( "-" | "+" | "~" ) unary
              | "await" unary
              | "spawn" unary
              | "try" unary
              | "move" unary
              | power ;
power         = postfix [ "**" unary ] ;

(*  await e   suspend until the future e completes
    spawn e   start e as a concurrent task and return its handle
    try e     unwrap a `T ! E` result, returning the error to the caller
    move e    give up ownership of e                                           *)

postfix       = atom { trailer } ;
trailer       = "." IDENT
              | "?." IDENT
              | "(" [ arguments ] ")"
              | "[" subscripts "]" ;

(* A leading `mut` at the call site makes mutation visible to the reader:
   `integrate(mut world, dt)`.                                                 *)
arguments     = argument { "," argument } [ "," ] ;
argument      = [ "mut" ] expression
              | IDENT "=" expression
              | "*" expression
              | "**" expression ;

(* Indexing and slicing. Works on lists, arrays and N-dimensional tensors:
     t[i, j]        element           t[:, 0]        column
     t[1:9:2, ...]  strided slice     t[..., _]      append a new axis
     t[mask]        boolean mask      t[idx]         gather by index tensor    *)
subscripts    = subscript { "," subscript } [ "," ] ;
subscript     = expression
              | [ expression ] ":" [ expression ] [ ":" [ expression ] ]
              | "..."
              | "_" ;

atom          = IDENT
              | literal
              | "(" [ expression_list | expression comp_clauses ] ")"
              | "[" [ expression_list | expression comp_clauses ] "]"
              | "{" [ dict_items | dict_item comp_clauses
                    | expression_list | expression comp_clauses ] "}" ;

dict_items    = dict_item { "," dict_item } [ "," ] ;
dict_item     = expression ":" expression
              | "**" expression ;

comp_clauses  = comp_for { comp_for | comp_if } ;
comp_for      = "for" bind_target "in" pipeline ;
comp_if       = "if" pipeline ;

literal       = INT | FLOAT | STRING | "true" | "false" | "none" ;


(* ---- 7. Patterns --------------------------------------------------------- *)

(* A bare identifier binds a new name; a dotted name is compared by value;
   `Name(...)` destructures a struct or enum variant.                          *)
pattern       = or_pattern [ "as" IDENT ] ;
or_pattern    = primary_pat { "|" primary_pat } ;
primary_pat   = "_"
              | literal_pat [ ( ".." | "..=" ) literal_pat ]
              | IDENT
              | IDENT "." dotted_name
              | dotted_name "(" [ pattern_arg { "," pattern_arg } ] ")"
              | "(" [ seq_pat { "," seq_pat } [ "," ] ] ")"
              | "[" [ seq_pat { "," seq_pat } [ "," ] ] "]" ;
literal_pat   = [ "-" ] ( INT | FLOAT )
              | STRING | "true" | "false" | "none" ;
pattern_arg   = [ IDENT "=" ] pattern ;
seq_pat       = pattern
              | "*" ( IDENT | "_" ) ;


(* ---- 8. Reserved words --------------------------------------------------- *)

(* Hard keywords (never valid as identifiers):
     and any as async await break case catch class const continue defer elif
     else enum export extern false finally fn for from if impl import in is
     kernel let match move mut none not on or own par pass ptr pub raise ref
     return route routes shared spawn strict struct tensor trait true try type
     unsafe var weak while with

   Contextual keywords (reserved only directly after `route`):
     GET POST PUT PATCH DELETE HEAD OPTIONS WS SSE

   Ordinary predeclared names (not keywords): self, cpu, gpu, int, float, str,
   bool, i8..i64, u8..u64, f16, f32, f64, bf16, vec2, vec3, vec4, mat4, ...    *)


(* ---- 9. Lexical grammar -------------------------------------------------- *)
(* LEXICAL-SECTION *)

IDENT         = ( LETTER | "_" ) { LETTER | DIGIT | "_" } ;
                (* excluding hard keywords and the lone underscore "_" *)

INT           = ( DEC_DIGITS
                | "0x" HEX_DIGIT { HEX_DIGIT | "_" }
                | "0b" BIN_DIGIT { BIN_DIGIT | "_" }
                | "0o" OCT_DIGIT { OCT_DIGIT | "_" } ) [ INT_SUFFIX ] ;
FLOAT         = DEC_DIGITS "." DEC_DIGITS [ EXPONENT ] [ FLOAT_SUFFIX ]
              | DEC_DIGITS EXPONENT [ FLOAT_SUFFIX ]
              | DEC_DIGITS FLOAT_SUFFIX ;
DEC_DIGITS    = DIGIT { DIGIT | "_" } ;
EXPONENT      = ( "e" | "E" ) [ "+" | "-" ] DEC_DIGITS ;
INT_SUFFIX    = "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" ;
FLOAT_SUFFIX  = "f16" | "f32" | "f64" | "bf16" ;

(* Prefix f = interpolated ("{expr}" is evaluated), r = raw, b = bytes. *)
STRING        = [ "f" | "r" | "b" | "fr" ] ( SHORT_STRING | LONG_STRING ) ;
SHORT_STRING  = '"' { STRING_CHAR | ESCAPE } '"' ;
LONG_STRING   = '"""' { ANY_CHAR } '"""' ;
ESCAPE        = "\" ( "n" | "t" | "r" | "0" | "\" | '"' | "{" | "}"
                    | "x" HEX_DIGIT HEX_DIGIT
                    | "u{" HEX_DIGIT { HEX_DIGIT } "}" ) ;

COMMENT       = "#" { any character except newline } ;      (* discarded *)
DOC_COMMENT   = "##" { any character except newline } ;     (* attached to the next declaration *)

NEWLINE       = end of a logical line (outside brackets) ;
INDENT        = indentation deeper than the enclosing block (4 spaces; tabs are an error) ;
DEDENT        = indentation returning to an enclosing block ;

LETTER        = "a".."z" | "A".."Z" | any Unicode XID_Start character ;
DIGIT         = "0".."9" ;
HEX_DIGIT     = DIGIT | "a".."f" | "A".."F" ;
BIN_DIGIT     = "0" | "1" ;
OCT_DIGIT     = "0".."7" ;
